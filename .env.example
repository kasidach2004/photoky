# ============================================================================
# PhotoKY - Environment Configuration Template (.env.example)
# Copy this file to .env and set your own credentials
# ============================================================================

APP_ENV=production
APP_URL=http://localhost:8080

# 1. Web Admin Panel Credentials (/admin/login.php)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@photoky.local
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ADMIN_RECOVERY_KEY=CHANGE_ME_RECOVERY_KEY

# 2. MySQL Database Credentials
DB_HOST=db
DB_PORT=3306
DB_NAME=photoky
DB_USER=photoky_user
DB_PASS=CHANGE_ME_DB_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MYSQL_DATABASE=photoky
MYSQL_USER=photoky_user
MYSQL_PASSWORD=CHANGE_ME_DB_PASSWORD
